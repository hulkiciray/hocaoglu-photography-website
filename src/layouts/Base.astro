---
import { url } from "../lib/url";
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Header sits transparently on top of a full-screen hero (home page). */
  overlayHeader?: boolean;
  /** Absolute or root-relative URL of the social preview image. */
  image?: string;
}

const { title, description = site.description, overlayHeader = false, image } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.hideFromSearchEngines && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="theme-color" content="#faf7f2" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class:list={{ 'has-overlay-header': overlayHeader }}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Fade images in as they finish loading.
      const markLoaded = (wrap: Element) => wrap.classList.add('is-loaded');
      document.querySelectorAll('.fade-img').forEach((wrap) => {
        const img = wrap.querySelector('img');
        if (!img || img.complete) return markLoaded(wrap);
        img.addEventListener('load', () => markLoaded(wrap), { once: true });
        img.addEventListener('error', () => markLoaded(wrap), { once: true });
      });

      // Gently reveal sections as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
