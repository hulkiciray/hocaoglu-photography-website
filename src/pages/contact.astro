---
import Base from '../layouts/Base.astro';
import { categories, faqs, site } from '../site.config';
---

<Base title="Contact" description={`Book a newborn, children, wedding or custom photo session with ${site.name}.`}>
  <header class="page-head container">
    <span class="eyebrow">Contact</span>
    <h1>Let's talk about your session</h1>
    <p class="lead">
      Tell me a little about what you have in mind and I'll get back to you within one working day with availability
      and details.
    </p>
  </header>

  <section class="container contact">
    <form
      class="form"
      method="POST"
      action={site.formEndpoint || undefined}
      data-endpoint={site.formEndpoint}
      data-email={site.email}
      data-form
    >
      <div class="row">
        <label>
          <span>Your name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
      </div>
      <div class="row">
        <label>
          <span>Phone <em>(optional)</em></span>
          <input name="phone" type="tel" autocomplete="tel" />
        </label>
        <label>
          <span>Session type</span>
          <select name="session" required data-session>
            <option value="" disabled selected>Choose…</option>
            {categories.map((c) => <option value={c.id}>{c.heading}</option>)}
            <option value="other">Something else</option>
          </select>
        </label>
      </div>
      <div class="row">
        <label>
          <span>Preferred date <em>(or due date)</em></span>
          <input name="date" type="date" />
        </label>
        <label>
          <span>Location <em>(optional)</em></span>
          <input name="location" />
        </label>
      </div>
      <label>
        <span>Message</span>
        <textarea name="message" rows="6" required placeholder="A few words about you and what you'd like…"></textarea>
      </label>
      <button class="btn" type="submit">Send enquiry</button>
      <p class="status" role="status" data-status></p>
    </form>

    <aside class="direct">
      <h2>Or reach me directly</h2>
      <ul>
        <li>
          <span>Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>Phone</span>
          {site.phoneDisplay}
        </li>
        {
          site.whatsapp && (
            <li>
              <span>WhatsApp</span>
              <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">
                Send a message
              </a>
            </li>
          )
        }
        <li>
          <span>Instagram</span>
          <a href={site.instagramUrl} target="_blank" rel="noopener">{site.instagramHandle}</a>
        </li>
        <li>
          <span>Based in</span>
          {site.city}, available for travel
        </li>
      </ul>
    </aside>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">Good to know</span>
        <h2>Frequently asked</h2>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(40px, 6vw, 96px);
    padding-bottom: clamp(64px, 10vw, 120px);
  }

  .form {
    display: grid;
    gap: 22px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  label {
    display: grid;
    gap: 6px;
  }
  label span {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  label em {
    font-style: normal;
    font-weight: 300;
    letter-spacing: 0.05em;
    text-transform: none;
    color: var(--muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.8em 0.9em;
    transition: border-color 0.25s;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  textarea {
    resize: vertical;
  }
  .form .btn {
    justify-self: start;
  }
  .status {
    min-height: 1.5em;
    margin: 0;
    color: var(--accent);
  }

  .direct h2 {
    font-size: 2rem;
  }
  .direct ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .direct li {
    display: grid;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .direct li span {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .direct a {
    text-decoration: none;
  }
  .direct a:hover {
    color: var(--accent);
  }

  .faq details {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq summary {
    font-family: var(--serif);
    font-size: 1.4rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--sans);
    font-weight: 300;
    transition: transform 0.3s var(--ease);
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq p {
    margin: 0.8rem 0 0;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const select = form.querySelector<HTMLSelectElement>('[data-session]')!;

  // Pre-select the session type when coming from a gallery page (/contact/?type=weddings).
  const type = new URLSearchParams(location.search).get('type');
  if (type && [...select.options].some((o) => o.value === type)) select.value = type;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const endpoint = form.dataset.endpoint;

    if (!endpoint) {
      // No form service configured yet: open the visitor's email app with everything filled in.
      const sessionLabel = select.selectedOptions[0]?.textContent ?? '';
      const body = [
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Phone: ${data.get('phone') || '-'}`,
        `Session: ${sessionLabel}`,
        `Preferred date: ${data.get('date') || '-'}`,
        `Location: ${data.get('location') || '-'}`,
        '',
        String(data.get('message') ?? ''),
      ].join('\n');
      const subject = `Session enquiry: ${sessionLabel}`;
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return;
    }

    status.textContent = 'Sending…';
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = "Thank you! Your message is on its way. I'll be in touch within a day.";
    } catch {
      status.textContent = 'Sorry, something went wrong. Please email me directly instead.';
    }
  });
</script>
