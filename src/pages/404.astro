---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="page-head container" style="min-height:60vh">
    <span class="eyebrow">404</span>
    <h1>This page wandered off</h1>
    <p class="lead">The page you're looking for doesn't exist, but there's plenty more to see.</p>
    <p><a class="btn" href="/">Back to home</a></p>
  </section>
</Base>
