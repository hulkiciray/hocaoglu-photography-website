---
import { url } from "../lib/url";
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookingCta from '../components/BookingCta.astro';
import { categories, site } from '../site.config';
import aboutPhoto from '../assets/about.jpg';

const steps = [
  {
    title: 'Say hello',
    text: 'Send a message with the kind of session and the dates you have in mind. I reply within a day.',
  },
  {
    title: 'Plan together',
    text: 'We talk through location, timing, outfits and the little things that matter to you. No surprises.',
  },
  {
    title: 'The session',
    text: 'Relaxed and unhurried. I guide gently when needed and otherwise let real moments happen.',
  },
  {
    title: 'Your gallery',
    text: 'Hand-edited photographs delivered in a private online gallery, ready to download, share and print.',
  },
];
---

<Base title="About" description={`Meet the photographer behind ${site.name}.`}>
  <section class="page-head container intro">
    <div class="intro-img fade-img">
      <Picture
        src={aboutPhoto}
        formats={['avif', 'webp']}
        widths={[480, 900, 1200]}
        sizes="(max-width: 860px) 100vw, 45vw"
        alt={`Portrait of the photographer, ${site.name}`}
        loading="eager"
      />
    </div>
    <div class="intro-text">
      <span class="eyebrow">About</span>
      <h1>Hello, I'm Ismail</h1>
      <p class="lead">
        A {site.city}-based photographer who believes the best photographs are the honest ones.
      </p>
      <p>
        Replace this text with your own story: how you started photographing, what you love about it, and what
        makes your sessions different. Clients choosing a newborn or family photographer want to feel they know
        and trust the person who'll be in the room, so a personal, warm tone works best here.
      </p>
      <p>
        Mention your experience, any newborn safety training, the equipment or light you prefer, and a small
        personal detail or two (coffee order, favourite place to shoot, your own family).
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">How it works</span>
        <h2>From first message to final gallery</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li data-reveal style={`transition-delay:${i * 80}ms`}>
              <span class="num">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Sessions</span>
        <h2>What I photograph</h2>
      </div>
      <div class="sessions">
        {
          categories.map((c) => (
            <a href={url(`/${c.id}/`)} class="session" data-reveal>
              <h3>{c.heading}</h3>
              <p>{c.intro}</p>
              <span class="link-arrow">View gallery</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <BookingCta />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    text-align: left;
  }
  .intro p {
    margin-inline: 0;
  }
  .intro-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--placeholder);
  }
  .intro-img :global(picture),
  .intro-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(24px, 3vw, 40px);
  }
  .num {
    font-family: var(--serif);
    font-size: 2.6rem;
    color: var(--accent);
    line-height: 1;
  }
  .steps h3 {
    margin-top: 0.6rem;
  }
  .steps p {
    color: var(--muted);
  }

  .sessions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }
  .session {
    display: block;
    padding: clamp(28px, 3.5vw, 48px);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.3s var(--ease);
  }
  .session:hover {
    border-color: var(--accent);
  }
  .session p {
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .intro,
    .sessions {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
