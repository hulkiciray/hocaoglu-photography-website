---
import { url } from "../lib/url";
interface Props {
  title?: string;
  text?: string;
  /** Pre-selects the session type on the contact form. */
  type?: string;
}
const {
  title = "Let's create something you'll treasure",
  text = 'Dates fill up quickly, especially for weddings and newborns. Send a short message and I will get back to you within a day.',
  type,
} = Astro.props;
const href = url(type ? `/contact/?type=${type}` : '/contact/');
---

<section class="cta section section--alt">
  <div class="container narrow" data-reveal>
    <span class="eyebrow">Booking</span>
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <a class="btn" href={href}>Check availability</a>
  </div>
</section>

<style>
  .cta {
    text-align: center;
  }
  .lead {
    max-width: 560px;
    margin: 0 auto 2rem;
  }
</style>
