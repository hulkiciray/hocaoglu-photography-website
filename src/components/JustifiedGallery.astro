---
/**
 * Justified photo grid: every row has the same height and photos keep their natural proportions
 * (nothing gets cropped). Clicking a photo opens it full screen in the lightbox.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/photos';
import { lightboxImage } from '../lib/lightbox';

interface Props {
  photos: Photo[];
  /** Target row height on desktop in px. */
  rowHeight?: number;
  /** Number of photos loaded immediately (the rest load as you scroll). */
  eager?: number;
}

const { photos, rowHeight = 300, eager = 4 } = Astro.props;

const items = await Promise.all(
  photos.map(async (p) => {
    const full = await lightboxImage(p);
    return { ...p, full: full.src, width: full.width, height: full.height, ar: (p.image.width / p.image.height).toFixed(4) };
  }),
);
---

<div class="jg" data-lightbox style={`--row-h:${rowHeight}px`}>
  {
    items.map((p, i) => (
      <a
        class="jg-item fade-img"
        href={p.full}
        data-pswp-width={p.width}
        data-pswp-height={p.height}
        style={`--ar:${p.ar}`}
      >
        <Picture
          src={p.image}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 34vw"
          alt={p.alt}
          loading={i < eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    ))
  }
</div>

<style>
  .jg {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(6px, 0.8vw, 12px);
  }

  /* Stops the last row from stretching to full width. */
  .jg::after {
    content: '';
    flex-grow: 999999;
  }

  .jg-item {
    position: relative;
    display: block;
    flex-grow: var(--ar);
    flex-basis: calc(var(--ar) * var(--row-h));
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--placeholder);
    cursor: zoom-in;
  }

  .jg-item :global(picture),
  .jg-item :global(img) {
    width: 100%;
    height: 100%;
  }

  .jg-item :global(img) {
    object-fit: cover;
    transition:
      transform 1.2s var(--ease),
      opacity 0.7s var(--ease) !important;
  }

  .jg-item:hover :global(img) {
    transform: scale(1.035);
  }

  @media (max-width: 900px) {
    .jg {
      --row-h: 220px !important;
    }
  }
  @media (max-width: 520px) {
    .jg {
      --row-h: 160px !important;
    }
  }
</style>

<script>
  import '../scripts/lightbox';
</script>

<style is:global>
  .pswp {
    --pswp-bg: #12100e;
    --pswp-icon-color: #f2ede5;
  }
  .pswp__counter {
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    opacity: 0.75;
  }
</style>
