---
import { Picture } from 'astro:assets';
import { albumUrl, formatDate, type Album } from '../lib/photos';

interface Props {
  album: Album;
  eager?: boolean;
}
const { album, eager = false } = Astro.props;
const meta = [album.location, formatDate(album.date)].filter(Boolean).join(' · ');
---

<a class="album-card" href={albumUrl(album)} data-reveal>
  <div class="frame fade-img">
    <Picture
      src={album.cover.image}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
      alt={album.cover.alt}
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="text">
    {meta && <span class="eyebrow">{meta}</span>}
    <h3>{album.title}</h3>
    {album.subtitle && <p>{album.subtitle}</p>}
    <span class="count">{album.photos.length} photographs</span>
  </div>
</a>

<style>
  .album-card {
    display: block;
    text-decoration: none;
  }

  .frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--placeholder);
  }

  .frame :global(picture),
  .frame :global(img) {
    width: 100%;
    height: 100%;
  }
  .frame :global(img) {
    object-fit: cover;
    transition:
      transform 1.4s var(--ease),
      opacity 0.7s var(--ease) !important;
  }
  .album-card:hover .frame :global(img) {
    transform: scale(1.04);
  }

  .text {
    padding-top: 1.2rem;
    text-align: center;
  }
  .eyebrow {
    margin-bottom: 0.4rem;
  }
  h3 {
    font-size: 1.9rem;
    margin-bottom: 0.2rem;
  }
  p {
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .count {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
