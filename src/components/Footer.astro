---
import { categories, site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <a href="/" class="logo">{site.name}</a>
      <p class="muted">{site.tagline}. Based in {site.city}, available for travel.</p>
    </div>

    <div>
      <h4>Portfolio</h4>
      <ul>
        {categories.map((c) => <li><a href={`/${c.id}/`}>{c.heading}</a></li>)}
      </ul>
    </div>

    <div>
      <h4>Get in touch</h4>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.whatsapp && <li><a href={`https://wa.me/${site.whatsapp}`} rel="noopener" target="_blank">WhatsApp</a></li>}
        <li><a href={site.instagramUrl} rel="noopener" target="_blank">Instagram {site.instagramHandle}</a></li>
        <li><a href="/contact/">Booking enquiry</a></li>
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <span>© {year} {site.name}. All photographs are protected by copyright.</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: #d9d2ca;
    padding-top: clamp(56px, 8vw, 96px);
    font-size: 0.95rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }

  .logo {
    font-family: var(--serif);
    font-size: 1.8rem;
    color: #fff;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.6rem;
  }

  .muted {
    color: #a39a91;
    max-width: 34ch;
  }

  h4 {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #fff;
    margin: 0.4rem 0 1rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  a {
    text-decoration: none;
    transition: color 0.25s;
  }
  ul a:hover {
    color: #fff;
  }

  .bottom {
    margin-top: clamp(48px, 6vw, 72px);
    padding-block: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: #8a8178;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
